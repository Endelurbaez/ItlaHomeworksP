@model IEnumerable<Parking.Main.Models.ClienteViewModel>
@{
    ViewData["Title"] = "Clientes";
}

<h2>Clientes</h2>
<a asp-action="Create" class="btn btn-primary mb-2">Nuevo Cliente</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Nombre</td>
                <td>@cliente.Cedula</td>
                <td>@cliente.Telefono</td>
                <td>@cliente.Correo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
