<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Parking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-4">
        <nav class="navbar navbar-expand-lg navbar-light bg-light mb-3">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Parking</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Cliente" asp-action="Index">Clientes</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Vehiculo" asp-action="Index">Vehículos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Tarifa" asp-action="Index">Tarifas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Ticket" asp-action="Index">Tickets</a></li>
                </ul>
            </div>
        </nav>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
