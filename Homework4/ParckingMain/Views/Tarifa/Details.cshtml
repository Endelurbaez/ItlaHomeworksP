@model Parking.Main.Models.TarifaViewModel

@{
    ViewData["Title"] = "Detalles Tarifa";
}

<h2>Detalles de la Tarifa</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Precio por Hora</dt>
        <dd class="col-sm-10">@Model.PrecioPorHora</dd>
    </dl>
</div>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
