@model Parking.Main.Models.TarifaViewModel

@{
    ViewData["Title"] = "Editar Tarifa";
}

<h2>Editar Tarifa</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control"/>
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrecioPorHora"></label>
        <input asp-for="PrecioPorHora" class="form-control"/>
        <span asp-validation-for="PrecioPorHora" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
