@model IEnumerable<Parking.Main.Models.TarifaViewModel>

@{
    ViewData["Title"] = "Tarifas";
}

<h2>Tarifas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Tarifa</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio por Hora</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Nombre</td>
        <td>@item.PrecioPorHora</td>
        <td>
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
        </td>
    </tr>
}
    </tbody>
</table>
