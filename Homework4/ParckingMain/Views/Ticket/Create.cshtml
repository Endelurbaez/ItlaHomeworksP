@model Parking.Main.Models.TicketViewModel

@{
    ViewData["Title"] = "Nuevo Ticket";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-ticket"></i> Nuevo Ticket de Estacionamiento
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="ticketForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Vehículo -->
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-car-front"></i> Información del Vehículo
                            </h5>

                            <div class="mb-3">
                                <label asp-for="VehiculoId" class="form-label required">
                                    Seleccionar Vehículo
                                </label>
                                @if (ViewBag.Vehiculos != null && ((IEnumerable<dynamic>)ViewBag.Vehiculos).Any())
                                {
                                    <select asp-for="VehiculoId" class="form-control" id="vehiculoSelect" required>
                                        <option value="">-- Seleccionar Vehículo --</option>
                                        @foreach (var vehiculo in ViewBag.Vehiculos)
                                        {
                                            <option value="@vehiculo.Id"
                                                    data-placa="@vehiculo.Placa"
                                                    data-marca="@vehiculo.Marca"
                                                    data-cliente="@vehiculo.ClienteNombre">
                                                @vehiculo.Placa - @vehiculo.Marca @vehiculo.Modelo (@vehiculo.ClienteNombre)
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        No hay vehículos registrados.
                                        <a asp-controller="Vehiculo" asp-action="Create" class="alert-link">
                                            Registrar vehículo primero
                                        </a>
                                    </div>
                                }
                                <span asp-validation-for="VehiculoId" class="text-danger"></span>
                            </div>

                            <div class="row" id="vehiculoInfo" style="display: none;">
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6>Información del Vehículo:</h6>
                                            <p class="mb-1"><strong>Placa:</strong> <span id="infoPlaca"></span></p>
                                            <p class="mb-1"><strong>Marca:</strong> <span id="infoMarca"></span></p>
                                            <p class="mb-0"><strong>Cliente:</strong> <span id="infoCliente"></span></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tarifa -->
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-currency-dollar"></i> Tarifa Aplicable
                            </h5>

                            <div class="mb-3">
                                <label asp-for="TarifaId" class="form-label required">
                                    Seleccionar Tarifa
                                </label>
                                @if (ViewBag.Tarifas != null && ((IEnumerable<dynamic>)ViewBag.Tarifas).Any())
                                {
                                    <select asp-for="TarifaId" class="form-control" id="tarifaSelect" required>
                                        <option value="">-- Seleccionar Tarifa --</option>
                                        @foreach (var tarifa in ViewBag.Tarifas)
                                        {
                                            <option value="@tarifa.Id"
                                                    data-precio="@tarifa.PrecioPorHora"
                                                    data-nombre="@tarifa.Nombre">
                                                @tarifa.Nombre - @tarifa.PrecioPorHora.ToString("C")/hora
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        No hay tarifas configuradas.
                                        <a asp-controller="Tarifa" asp-action="Create" class="alert-link">
                                            Configurar tarifa primero
                                        </a>
                                    </div>
                                }
                                <span asp-validation-for="TarifaId" class="text-danger"></span>
                            </div>

                            <div id="tarifaInfo" style="display: none;">
                                <p class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Precio seleccionado: <strong id="infoPrecio"></strong> por hora
                                </p>
                            </div>
                        </div>

                        <!-- Fecha de Entrada -->
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-clock"></i> Fecha y Hora
                            </h5>

                            <div class="mb-3">
                                <label asp-for="FechaEntrada" class="form-label required">
                                    Fecha y Hora de Entrada
                                </label>
                                <input asp-for="FechaEntrada" class="form-control"
                                       type="datetime-local"
                                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                       required />
                                <span asp-validation-for="FechaEntrada" class="text-danger"></span>
                                <div class="form-text">Fecha y hora en que el vehículo ingresó al estacionamiento</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Resumen -->
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-receipt"></i> Resumen del Ticket
                                </h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Vehículo:</strong> <span id="resumenVehiculo">--</span></p>
                                        <p class="mb-1"><strong>Cliente:</strong> <span id="resumenCliente">--</span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Tarifa:</strong> <span id="resumenTarifa">--</span></p>
                                        <p class="mb-1"><strong>Precio/Hora:</strong> <span id="resumenPrecio">--</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Crear Ticket
                                </button>
                                <button type="reset" class="btn btn-secondary">
                                    <i class="bi bi-arrow-clockwise"></i> Limpiar
                                </button>
                            </div>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
    .required:after {
        content: " *";
        color: #dc3545;
    }

    .card {
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Mostrar información del vehículo seleccionado
            $('#vehiculoSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                if (selectedOption.val()) {
                    $('#vehiculoInfo').show();
                    $('#infoPlaca').text(selectedOption.data('placa'));
                    $('#infoMarca').text(selectedOption.data('marca'));
                    $('#infoCliente').text(selectedOption.data('cliente'));

                    // Actualizar resumen
                    $('#resumenVehiculo').text(selectedOption.data('placa') + ' - ' + selectedOption.data('marca'));
                    $('#resumenCliente').text(selectedOption.data('cliente'));
                } else {
                    $('#vehiculoInfo').hide();
                    $('#resumenVehiculo').text('--');
                    $('#resumenCliente').text('--');
                }
            });

            // Mostrar información de la tarifa seleccionada
            $('#tarifaSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                if (selectedOption.val()) {
                    $('#tarifaInfo').show();
                    var precio = parseFloat(selectedOption.data('precio'));
                    $('#infoPrecio').text('$' + precio.toFixed(2));

                    // Actualizar resumen
                    $('#resumenTarifa').text(selectedOption.data('nombre'));
                    $('#resumenPrecio').text('$' + precio.toFixed(2) + '/hora');
                } else {
                    $('#tarifaInfo').hide();
                    $('#resumenTarifa').text('--');
                    $('#resumenPrecio').text('--');
                }
            });

            // Validación del formulario
            $('#ticketForm').submit(function(e) {
                var vehiculoId = $('#vehiculoSelect').val();
                var tarifaId = $('#tarifaSelect').val();

                if (!vehiculoId || vehiculoId <= 0) {
                    alert('Por favor selecciona un vehículo válido');
                    e.preventDefault();
                    return false;
                }

                if (!tarifaId || tarifaId <= 0) {
                    alert('Por favor selecciona una tarifa válida');
                    e.preventDefault();
                    return false;
                }

                return true;
            });
        });
    </script>
}