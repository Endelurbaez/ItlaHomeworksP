@model Parking.Main.Models.TicketViewModel

@{
    ViewData["Title"] = "Editar Ticket";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Editar Ticket #@Model.Id
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Vehículo</label>
                            <div class="form-control bg-light">
                                <strong>@Model.PlacaVehiculo</strong> - @Model.MarcaVehiculo
                                <br>
                                <small class="text-muted">Cliente: @Model.ClienteNombre</small>
                            </div>
                            <input type="hidden" asp-for="VehiculoId" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="TarifaId" class="form-label">Tarifa</label>
                            @if (ViewBag.Tarifas != null)
                            {
                                <select asp-for="TarifaId" class="form-control">
                                    @foreach (var tarifa in ViewBag.Tarifas)
                                    {
                                        <option value="@tarifa.Id"
                                                selected="@(tarifa.Id == Model.TarifaId)"
                                                data-precio="@tarifa.PrecioPorHora">
                                            @tarifa.Nombre - @tarifa.PrecioPorHora.ToString("C")/hora
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input asp-for="TarifaId" class="form-control" type="number" />
                            }
                            <span asp-validation-for="TarifaId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaEntrada" class="form-label">Fecha de Entrada</label>
                                <input asp-for="FechaEntrada" class="form-control" type="datetime-local"
                                       value="@Model.FechaEntrada.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="FechaEntrada" class="text-danger"></span>
                            </div>

                            @if (Model.Estado != "Activo")
                            {
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FechaSalida" class="form-label">Fecha de Salida</label>
                                    <input asp-for="FechaSalida" class="form-control" type="datetime-local"
                                           value="@(Model.FechaSalida?.ToString("yyyy-MM-ddTHH:mm"))" />
                                    <span asp-validation-for="FechaSalida" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        @if (Model.Estado != "Activo")
                        {
                            <div class="alert alert-info">
                                <h6>Información de Pago:</h6>
                                <p class="mb-1"><strong>Horas:</strong> @(Model.HorasTranscurridas?.ToString() ?? "0") horas</p>
                                <p class="mb-1"><strong>Total a Pagar:</strong> @(Model.TotalPagar?.ToString("C") ?? "$0.00")</p>
                                <p class="mb-0"><strong>Estado:</strong> <span class="badge @Model.EstadoBadgeClass">@Model.Estado</span></p>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Estado" class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-control">
                                <option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option>
                                <option value="Pagado" selected="@(Model.Estado == "Pagado")">Pagado</option>
                                <option value="Cerrado" selected="@(Model.Estado == "Cerrado")">Cerrado</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <div>
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-check-circle"></i> Guardar Cambios
                                </button>
                            </div>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="bi bi-eye"></i> Ver Detalles
                </a>
                @if (Model.Estado == "Activo")
                {
                    <a asp-action="Cerrar" asp-route-id="@Model.Id" class="btn btn-success">
                        <i class="bi bi-cash"></i> Cerrar y Calcular Pago
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}