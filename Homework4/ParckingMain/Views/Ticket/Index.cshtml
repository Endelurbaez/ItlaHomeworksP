@model IEnumerable<Parking.Main.Models.TicketViewModel>

@{
    ViewData["Title"] = "Tickets";
}

<div class="container mt-4">
    <h2 class="mb-4">Tickets de Estacionamiento</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Ticket
        </a>

        <div class="text-muted">
            <span class="badge bg-warning">Activos: @(Model?.Count(t => t.Estado == "Activo") ?? 0)</span>
            <span class="badge bg-success ms-2">Pagados: @(Model?.Count(t => t.Estado == "Pagado") ?? 0)</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Ticket ID</th>
                    <th>Vehículo</th>
                    <th>Cliente</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Horas</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>#@item.Id</strong>
                            </td>
                            <td>
                                <div>
                                    <strong>@item.PlacaVehiculo</strong><br>
                                    <small class="text-muted">@item.MarcaVehiculo</small>
                                </div>
                            </td>
                            <td>@item.ClienteNombre</td>
                            <td>@item.FechaEntrada.ToString("g")</td>
                            <td>
                                @if (item.FechaSalida.HasValue)
                                {
                                    @item.FechaSalida.Value.ToString("g")
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>
                            <td>
                                @if (item.HorasTranscurridas.HasValue)
                                {
                                    <span class="badge bg-info">@item.HorasTranscurridas h</span>
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>
                            <td>
                                @if (item.TotalPagar.HasValue)
                                {
                                    <strong class="text-success">@item.TotalPagar.Value.ToString("C")</strong>
                                }
                                else
                                {
                                    <span class="text-muted">Pendiente</span>
                                }
                            </td>
                            <td>
                                <span class="@item.EstadoBadgeClass">
                                    @item.Estado
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-info" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (item.Estado == "Activo")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Cerrar" asp-route-id="@item.Id"
                                           class="btn btn-success" title="Cerrar Ticket">
                                            <i class="bi bi-cash"></i>
                                        </a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4">
                            <div class="text-muted">
                                <i class="bi bi-ticket display-4"></i>
                                <h5 class="mt-3">No hay tickets registrados</h5>
                                <p class="mb-0">Comienza creando un nuevo ticket</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .btn-group .btn {
        margin: 0 2px;
        border-radius: 4px;
    }
</style>