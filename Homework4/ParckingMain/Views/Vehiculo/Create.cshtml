@model Parking.Main.Models.VehiculoViewModel

@{
    ViewData["Title"] = "Registrar Vehículo";
}

<div class="container mt-4">
    <h2 class="mb-4">Registrar Nuevo Vehículo</h2>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Placa" class="form-label">Placa *</label>
                    <input asp-for="Placa" class="form-control" placeholder="Ej: ABC-123" />
                    <span asp-validation-for="Placa" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Marca" class="form-label">Marca *</label>
                    <input asp-for="Marca" class="form-control" placeholder="Ej: Toyota" />
                    <span asp-validation-for="Marca" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Modelo" class="form-label">Modelo *</label>
                    <input asp-for="Modelo" class="form-control" placeholder="Ej: Corolla" />
                    <span asp-validation-for="Modelo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Color" class="form-label">Color</label>
                    <input asp-for="Color" class="form-control" placeholder="Ej: Rojo" />
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Ano" class="form-label">Año</label>
                    <input asp-for="Ano" class="form-control" type="number"
                           min="1900" max="@DateTime.Now.Year"
                           placeholder="Ej: 2023" />
                    <span asp-validation-for="Ano" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClienteId" class="form-label">Cliente *</label>
                    @if (ViewBag.Clientes != null)
                    {
                        <select asp-for="ClienteId" class="form-control"
                                asp-items="@(new SelectList(ViewBag.Clientes, "Id", "NombreCompleto"))">
                            <option value="">-- Seleccionar Cliente --</option>
                        </select>
                    }
                    else
                    {
                        <input asp-for="ClienteId" class="form-control" type="number"
                               placeholder="ID del Cliente" />
                        <small class="text-muted">No se pudieron cargar los clientes. Ingresa el ID manualmente.</small>
                    }
                    <span asp-validation-for="ClienteId" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Vehículo
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al Listado
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Validación simple
            $('form').submit(function() {
                var clienteId = $('#ClienteId').val();
                if (!clienteId || clienteId <= 0) {
                    alert('Por favor selecciona un cliente válido');
                    return false;
                }
                return true;
            });
        });
    </script>
}